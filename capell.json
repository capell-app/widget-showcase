{
    "manifest-version": 3,
    "name": "capell-app/widget-showcase",
    "slug": "widget-showcase",
    "displayName": "Widget Showcase",
    "kind": "bundle",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "A dependency bundle that installs all ten Capell Foundation widget extensions together; it adds no runtime surface itself.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\WidgetShowcase",
    "surfaces": [],
    "dependencies": {
        "requires": [
            "capell-app/widget-audio-playlist",
            "capell-app/widget-before-after",
            "capell-app/widget-content-reveal",
            "capell-app/widget-countdown",
            "capell-app/widget-data-chart",
            "capell-app/widget-hotspots",
            "capell-app/widget-live-poll",
            "capell-app/widget-location-map",
            "capell-app/widget-slideshow",
            "capell-app/widget-youtube"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [],
        "admin": [],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "setupParams": [],
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 0,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Install the ten free Capell Essentials widget extensions together. This dependency bundle has no page or widget of its own.",
        "description": "Widget Showcase installs the ten free Capell Essentials widget extensions in one step: audio playlist, before and after, content reveal, countdown, data chart, hotspots, live poll, location map, slideshow and YouTube. Each widget needs Layout Builder and keeps its own limits and settings. The bundle itself adds no screens, settings or public output.",
        "problem": "Teams assembling a set of page widgets must identify and install each package individually.",
        "outcome": "A site has the bundle’s required widget packages available through their own registrations.",
        "faq": [
            {
                "question": "Does the bundle add its own widget?",
                "answer": "No. It has no editor or public runtime surface of its own."
            },
            {
                "question": "How are included widgets made available?",
                "answer": "The ten standalone widget packages provide their own registrations and surfaces."
            },
            {
                "question": "Is the widget bundle free?",
                "answer": "Yes. Widget Showcase is in the free tier."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/listing-widget-showcase-installed.png",
                "alt": "The ten Capell Essentials widgets installed together on one public page",
                "caption": "Installed widget showcase"
            },
            {
                "path": "docs/assets/marketplace/extension-card.svg",
                "alt": "Widget Showcase extension bundle card",
                "caption": "Widget Showcase installs all ten Foundation widget extensions."
            }
        ],
        "categories": ["bundle", "foundation"]
    }
}
