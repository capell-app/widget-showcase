{
    "name": "capell-app/widget-showcase",
    "description": "Install all ten free Capell Foundation widget extensions as one bundle.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "capell-app/widget-audio-playlist": "^0.0",
        "capell-app/widget-before-after": "^0.0",
        "capell-app/widget-content-reveal": "^0.0",
        "capell-app/widget-countdown": "^0.0",
        "capell-app/widget-data-chart": "^0.0",
        "capell-app/widget-hotspots": "^0.0",
        "capell-app/widget-live-poll": "^0.0",
        "capell-app/widget-location-map": "^0.0",
        "capell-app/widget-slideshow": "^0.0",
        "capell-app/widget-youtube": "^0.0"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
